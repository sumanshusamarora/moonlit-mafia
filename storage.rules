rules_version = '2';

// Firebase Storage Security Rules for Moonlit Mafia
// IMPORTANT: Deploy these rules to Firebase Console:
// 1. Go to Firebase Console > Storage > Rules tab
// 2. Replace the default rules with this file's content
// 3. Click "Publish"

service firebase.storage {
  match /b/{bucket}/o {
    
    // Voice messages - authenticated users can upload, anyone can read
    match /voice-messages/{gameId}/{fileName} {
      // Allow authenticated users (including anonymous) to write
      allow create: if request.auth != null 
                    && request.resource.size < 5 * 1024 * 1024  // Max 5MB
                    && request.resource.contentType.matches('audio/.*');
      
      // Allow updates and deletes by the uploader
      allow update, delete: if request.auth != null;
      
      // Allow anyone to read voice messages (needed for playback)
      allow read: if true;
    }
    
    // Deny all other access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
